{
  "info": {
    "name": "TravelEase Phase 13 Reviews Feedback",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/packages/{{packageId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "packages",
            "{{packageId}}"
          ]
        }
      }
    },
    {
      "name": "Package rating summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/packages/{{packageId}}/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "packages",
            "{{packageId}}",
            "summary"
          ]
        }
      }
    },
    {
      "name": "My reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/my",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "my"
          ]
        }
      }
    },
    {
      "name": "Submit review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"rating\": 5,\n  \"title\": \"Excellent family trip\",\n  \"comment\": \"The pickup was on time and the overall experience was excellent.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Edit review",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/{{reviewId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "{{reviewId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"Updated review after additional reflection.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/admin?status=pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "admin"
          ],
          "query": [
            {
              "key": "status",
              "value": "pending"
            }
          ]
        }
      }
    },
    {
      "name": "Admin analytics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/admin/analytics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "admin",
            "analytics"
          ]
        }
      }
    },
    {
      "name": "Approve review",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/admin/{{reviewId}}/moderate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "admin",
            "{{reviewId}}",
            "moderate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\",\n  \"moderationNote\": \"Verified review\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Submit feedback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"suggestion\",\n  \"subject\": \"Better pickup details\",\n  \"message\": \"Please include a map pin and driver contact in trip details.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "My feedback",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/feedback/my",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback",
            "my"
          ]
        }
      }
    },
    {
      "name": "Admin feedback",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/feedback/admin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback",
            "admin"
          ]
        }
      }
    },
    {
      "name": "Resolve feedback",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/feedback/admin/{{feedbackId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback",
            "admin",
            "{{feedbackId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\",\n  \"adminReply\": \"Thank you, we are working on this.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "packageId",
      "value": "REPLACE_PACKAGE_ID"
    },
    {
      "key": "bookingId",
      "value": "REPLACE_COMPLETED_BOOKING_ID"
    },
    {
      "key": "reviewId",
      "value": "REPLACE_REVIEW_ID"
    },
    {
      "key": "feedbackId",
      "value": "REPLACE_FEEDBACK_ID"
    }
  ]
}
